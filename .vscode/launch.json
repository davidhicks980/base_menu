    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web: Run all Tests",
            "type": "dart",
            "request": "launch",
            "args": [
                "--platform", "chrome",
                "--coverage",
            ],
            "program": "./test/"
        },
        {
            "name": "floogle_docs_deployment",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true", 
                "--dart-define=FONT_PACKAGE=base_menu_gallery"
            ]
        },
        {
            "name": "floogle_docs_deployment (WASM)",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",

            "args": [
                "--wasm",  
                "--dart-define=VISUALIZE_MENU_AIM=true", 
                "--dart-define=FONT_PACKAGE=base_menu_gallery"
            ]
        },
        {
            "name": "floogle_docs_deployment (profile mode)",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true", 
                "--dart-define=FONT_PACKAGE=base_menu_gallery"
            ]
        },
        {
            "name": "floogle_docs_deployment (release mode)",
