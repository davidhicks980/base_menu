{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web: Run all Tests",
            "type": "dart",
            "request": "launch",
            "args": [
                "--platform", "chrome",
                "--coverage",
            ],
            "program": "./test/"
        },

        {
            "name": "menu",
            "request": "launch",
            "type": "dart",
            "program": "example/lib/main.dart"

        },
        {
            "name": "menu (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "example/lib/main.dart"
        },
        {
            "name": "menu (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "example/lib/main.dart"
        },
        {
            "name": "example",
            "cwd": "example",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "example (WASM)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "args": [
                "--wasm"
            ]
        },
        {
            "name": "example (profile mode)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "example (release mode)",
            "cwd": "example",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },

        {
            "name": "floogle_docs_deployment",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true", "--dart-define=FONT_PACKAGE=base_menu_demo"
            ]

        },
        {
            "name": "floogle_docs_deployment (WASM)",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",

            "args": [
                "--wasm"
            ]
        },
        {
            "name": "floogle_docs_deployment (profile mode)",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true", "--dart-define=FONT_PACKAGE=base_menu_demo"
            ]
        },
        {
            "name": "floogle_docs_deployment (release mode)",
            "cwd": "deployments/floogle_docs",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true", "--dart-define=FONT_PACKAGE=base_menu_demo"
            ]
        },

             {
            "name": "floogle_docs",
            "cwd": "demo",
            "request": "launch",
            "type": "dart",
            "program": "lib/floogle_docs/floogle_docs.dart",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true"
            ]

        },
        {
            "name": "floogle_docs (WASM)",
            "cwd": "demo",
            "request": "launch",
            "type": "dart",
            "program": "lib/floogle_docs/floogle_docs.dart",

            "args": [
                  "--dart-define=VISUALIZE_MENU_AIM=true",
                "--wasm"
            ]
        },
        {
            "name": "floogle_docs (profile mode)",
            "cwd": "demo",
            "request": "launch",
            "type": "dart",
            "program": "lib/floogle_docs/floogle_docs.dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true"
            ]
        },
        {
            "name": "floogle_docs (release mode)",
            "cwd": "demo",
            "request": "launch",
            "type": "dart",
            "program": "lib/floogle_docs/floogle_docs.dart",
            "flutterMode": "release",
            "args": [
                "--dart-define=VISUALIZE_MENU_AIM=true"
            ]
        }
    ]
}